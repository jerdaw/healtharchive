# These values are public and are inlined into the Next.js client bundle at
# build time. Never pass secrets as NEXT_PUBLIC_* values or Docker build args.
ARG NEXT_PUBLIC_API_BASE_URL=https://api.healtharchive.ca
ARG NEXT_PUBLIC_REPLAY_BASE_URL=https://replay.healtharchive.ca
ARG NEXT_PUBLIC_SHOW_API_HEALTH_BANNER=false
ARG NEXT_PUBLIC_LOG_API_HEALTH_FAILURE=false
ARG NEXT_PUBLIC_SHOW_API_BASE_HINT=false

FROM node:20-bookworm-slim AS base
ENV NEXT_TELEMETRY_DISABLED=1

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps

FROM base AS builder
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_REPLAY_BASE_URL
ARG NEXT_PUBLIC_SHOW_API_HEALTH_BANNER
ARG NEXT_PUBLIC_LOG_API_HEALTH_FAILURE
ARG NEXT_PUBLIC_SHOW_API_BASE_HINT
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ENV NODE_ENV=production
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_REPLAY_BASE_URL=${NEXT_PUBLIC_REPLAY_BASE_URL}
ENV NEXT_PUBLIC_SHOW_API_HEALTH_BANNER=${NEXT_PUBLIC_SHOW_API_HEALTH_BANNER}
ENV NEXT_PUBLIC_LOG_API_HEALTH_FAILURE=${NEXT_PUBLIC_LOG_API_HEALTH_FAILURE}
ENV NEXT_PUBLIC_SHOW_API_BASE_HINT=${NEXT_PUBLIC_SHOW_API_BASE_HINT}
RUN npm run build

FROM node:20-bookworm-slim AS runner
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_REPLAY_BASE_URL
ARG NEXT_PUBLIC_SHOW_API_HEALTH_BANNER
ARG NEXT_PUBLIC_LOG_API_HEALTH_FAILURE
ARG NEXT_PUBLIC_SHOW_API_BASE_HINT
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL}
ENV NEXT_PUBLIC_REPLAY_BASE_URL=${NEXT_PUBLIC_REPLAY_BASE_URL}
ENV NEXT_PUBLIC_SHOW_API_HEALTH_BANNER=${NEXT_PUBLIC_SHOW_API_HEALTH_BANNER}
ENV NEXT_PUBLIC_LOG_API_HEALTH_FAILURE=${NEXT_PUBLIC_LOG_API_HEALTH_FAILURE}
ENV NEXT_PUBLIC_SHOW_API_BASE_HINT=${NEXT_PUBLIC_SHOW_API_BASE_HINT}
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs nextjs \
  && mkdir -p /app/.next/cache \
  && chown -R nextjs:nodejs /app/.next
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
